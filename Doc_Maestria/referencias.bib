@article{ZHANG2025108826,
  title    = {Underwater image enhancement via frequency and spatial domains fusion},
  journal  = {Optics and Lasers in Engineering},
  volume   = {186},
  pages    = {108826},
  year     = {2025},
  issn     = {0143-8166},
  doi      = {https://doi.org/10.1016/j.optlaseng.2025.108826},
  url      = {https://www.sciencedirect.com/science/article/pii/S0143816625000132},
  author   = {Weihong Zhang and Xiaobo Li and Yizhao Huang and Shuping Xu and Junwu Tang and Haofeng Hu},
  keywords = {Underwater image enhancement, Optical image restoration, Color correction, Contrast enhancement, Channel fusion},
  abstract = {In underwater imaging, the influence of light absorption and scattering in the water medium could cause image details blurring and color distortion, which can compromise the effectiveness of intelligent computer vision systems for visual inspection, environment perception, and object detection and recognition. To address these challenges, this paper proposes an image processing method for underwater image color restoration and detail enhancement to improve target detection rate. We first use a channel difference factor to categorize underwater images into undistorted and distorted images. This factor is determined by employing the quadtree search method to identify the optimal background region of the image. Based on the color bias, the degraded color channels are compensated in the spatial domain. Subsequently, homomorphic filtering is applied in the frequency domain to enhance the image contrast. To simplify the parametric control of the filter transfer function, the S-shape function can be used to reduce calculations significantly. Finally, the images undergo color correction and contrast enhancement before being fused in the color space to produce an image with improved contrast and richer color. Experimental results demonstrate that our algorithm performs well on a representative underwater image dataset and outperforms other image enhancement algorithms in terms of color, detail, and clarity, as well as achieve the best objective evaluation metrics. Additionally, the effectiveness and practicality of our proposed method are validated through computer vision feature point matching and underwater target detection experiments, demonstrating superior feature extraction capabilities.}
}




